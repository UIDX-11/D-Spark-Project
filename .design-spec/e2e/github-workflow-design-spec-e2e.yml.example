# Copy to: .github/workflows/design-spec-e2e.yml
# Requires a Git PAT / integration token with **workflow** scope to push workflow files.
name: Design spec — e2e & visual

on:
  pull_request:
    paths:
      - ".design-spec/**"
  push:
    branches: [main, design-spec-kb-v0.1]
    paths:
      - ".design-spec/**"

defaults:
  run:
    working-directory: .design-spec/e2e

jobs:
  playwright:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: npm
          cache-dependency-path: .design-spec/e2e/package-lock.json

      - name: Install dependencies
        run: npm ci

      - name: Install Playwright Chromium
        run: npx playwright install --with-deps chromium

      - name: Run Playwright tests
        run: npm test

      - name: Upload Playwright report
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: playwright-report
          path: .design-spec/e2e/playwright-report/

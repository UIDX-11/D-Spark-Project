{
  "name": "d-spark-tokens-semantic",
  "version": "0.1.0",
  "mode": "light",
  "tokens": {
    "bg": {
      "page": "{color.neutral.20}",
      "surface": "{color.neutral.0}",
      "card": "{color.neutral.0}",
      "muted": "{color.neutral.60}",
      "switchOff": "{color.neutral.90}",
      "switchOnDisabled": "{color.blue.30}",
      "switchKnobDisabled": "{color.blue.10}"
    },
    "text": {
      "primary": "{color.neutral.170}",
      "secondary": "{color.neutral.140}",
      "disabled": "{color.neutral.110}",
      "inverse": "{color.neutral.0}",
      "link": "{color.deepBlue.30}"
    },
    "border": {
      "default": "{color.neutral.80}",
      "strong": "{color.neutral.120}"
    },
    "action": {
      "primary": {
        "bg": "{color.neutral.170}",
        "bgHover": "{color.neutral.160}",
        "bgActive": "{color.neutral.180}",
        "bgDisabled": "{color.neutral.110}",
        "text": "{color.neutral.0}",
        "textDisabled": "{color.neutral.0}"
      }
    },
    "focus": {
      "ring": "{color.deepBlue.20}"
    },
    "radius": {
      "sm": "{radius.sm}",
      "md": "{radius.md}"
    },
    "status": {
      "success": "{color.green.50}",
      "warning": "{color.yellow.50}",
      "danger": "{color.red.50}",
      "info": "{color.blue.50}"
    }
  }
}

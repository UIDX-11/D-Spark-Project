{
  "name": "d-spark-tokens-component",
  "version": "0.1.0",
  "mode": "light",
  "tokens": {
    "button": {
      "primary": {
        "bgDefault": "{action.primary.bg}",
        "bgHover": "{action.primary.bgHover}",
        "bgActive": "{action.primary.bgActive}",
        "bgDisabled": "{action.primary.bgDisabled}",
        "textDefault": "{action.primary.text}",
        "textHover": "{action.primary.text}",
        "textActive": "{action.primary.text}",
        "textDisabled": "{text.inverse}",
        "radius": "{radius.md}"
      },
      "neutral": {
        "bgDefault": "{bg.surface}",
        "bgHover": "{bg.page}",
        "bgActive": "{bg.page}",
        "bgDisabled": "{bg.page}",
        "textDefault": "{text.primary}",
        "textHover": "{text.primary}",
        "textActive": "{text.primary}",
        "textDisabled": "{text.disabled}",
        "borderDefault": "{border.default}",
        "borderHover": "{border.default}",
        "borderActive": "{border.default}",
        "borderDisabled": "{border.default}"
      },
      "outline": {
        "borderDefault": "{border.strong}"
      },
      "link": {
        "textDefault": "{text.link}"
      },
      "danger": {
        "bgDefault": "{status.danger}",
        "textDefault": "{text.inverse}"
      }
    },
    "input": {
      "bgDefault": "{bg.surface}",
      "bgHover": "{bg.surface}",
      "bgFocus": "{bg.surface}",
      "bgTyping": "{bg.surface}",
      "bgCompleted": "{bg.surface}",
      "bgError": "{bg.surface}",
      "bgDisabled": "{bg.page}",

      "textDefault": "{text.secondary}",
      "textFocus": "{text.primary}",
      "textDisabled": "{text.disabled}",

      "borderDefault": "{border.default}",
      "borderHover": "{border.default}",
      "borderFocus": "{border.strong}",
      "borderError": "{status.danger}",
      "borderDisabled": "{border.default}",

      "ringFocus": "{focus.ring}",
      "ringError": "{status.danger}"
    },
    "checkbox": {
      "boxSize": 16,
      "boxRadius": 3,
      "gap": 8,

      "labelTextDefault": "{text.primary}",
      "labelTextDisabled": "{text.disabled}",

      "uncheckedBgDefault": "{bg.surface}",
      "uncheckedBorderDefault": "{border.strong}",
      "uncheckedBgHover": "{bg.surface}",
      "uncheckedBorderHover": "{text.primary}",
      "uncheckedBgDisabled": "{bg.surface}",
      "uncheckedBorderDisabled": "{border.default}",

      "checkedBgDefault": "{action.primary.bg}",
      "checkedMarkDefault": "{text.inverse}",
      "checkedBgDisabled": "{action.primary.bgDisabled}",
      "checkedMarkDisabled": "{text.inverse}",

      "indeterminateBgDefault": "{bg.surface}",
      "indeterminateBorderDefault": "{border.strong}",
      "indeterminateDashDefault": "{text.primary}",
      "indeterminateBgDisabled": "{bg.surface}",
      "indeterminateBorderDisabled": "{border.default}",
      "indeterminateDashDisabled": "{text.disabled}"
    },
    "radio": {
      "dotSize": 8,
      "outerSize": 16,
      "gap": 8,

      "labelTextDefault": "{text.primary}",
      "labelTextDisabled": "{text.disabled}",
      "helperTextDefault": "{text.secondary}",
      "helperTextDisabled": "{text.disabled}",

      "uncheckedBgDefault": "{bg.surface}",
      "uncheckedBorderDefault": "{border.strong}",
      "uncheckedBgHover": "{bg.surface}",
      "uncheckedBorderHover": "{text.primary}",
      "uncheckedBgDisabled": "{bg.surface}",
      "uncheckedBorderDisabled": "{border.default}",

      "checkedOuterDefault": "{action.primary.bg}",
      "checkedDotDefault": "{text.inverse}",
      "checkedOuterDisabled": "{action.primary.bgDisabled}",
      "checkedDotDisabled": "{text.inverse}"
    },
    "radioButton": {
      "gap": 8,

      "bgDefault": "{bg.surface}",
      "textDefault": "{text.secondary}",
      "bgSelected": "{action.primary.bg}",
      "textSelected": "{text.inverse}",
      "bgDisabled": "{bg.surface}",
      "textDisabled": "{text.disabled}",

      "radiusLg": "{radius.md}",
      "radiusMd": "{radius.md}",
      "radiusSm": "{radius.sm}",

      "pxLg": 8,
      "pyLg": 4,
      "pxMd": 8,
      "pyMd": 2,
      "pxSm": 8,
      "hSm": 20
    },
    "select": {
      "trigger": {
        "bg": {
          "default": "{bg.page}",
          "hover": "{bg.page}",
          "focus": "{bg.page}",
          "disabled": "{bg.page}",
          "error": "{bg.page}"
        },
        "border": {
          "default": "{border.default}",
          "hover": "{text.primary}",
          "focus": "{text.primary}",
          "disabled": "{border.default}",
          "error": "{status.danger}"
        },
        "text": {
          "default": "{text.secondary}",
          "focus": "{text.primary}",
          "disabled": "{text.disabled}"
        },
        "placeholder": "{text.secondary}",
        "icon": {
          "default": "{text.secondary}",
          "disabled": "{text.disabled}"
        },
        "ring": {
          "focus": "{focus.ring}",
          "error": "{status.danger}"
        }
      },
      "dropdown": {
        "bg": "{bg.surface}",
        "shadow": "0px 4px 10px 0px rgba(0,0,0,0.1)",
        "radius": "{radius.md}"
      },
      "item": {
        "text": "{text.primary}",
        "bg": {
          "default": "{bg.surface}",
          "hover": "{bg.page}",
          "selected": "{bg.page}"
        }
      }
    },
    "badge": {
      "count": {
        "bg": {
          "default": "{status.danger}",
          "disabled": "{bg.muted}"
        },
        "text": {
          "default": "{text.inverse}",
          "disabled": "{text.secondary}"
        },
        "height": 16,
        "radius": 999,
        "px": 6,
        "pxSingle": 4,
        "minWidthSingle": 16
      },
      "dot": {
        "size": 6
      },
      "status": {
        "gap": 8,
        "dot": {
          "default": "{text.secondary}",
          "processing": "{focus.ring}",
          "success": "{status.success}",
          "warning": "{status.warning}",
          "error": "{status.danger}"
        },
        "label": "{text.primary}"
      }
    },
    "switch": {
      "track": {
        "on": {
          "default": "{status.info}",
          "disabled": "{bg.switchOnDisabled}"
        },
        "off": {
          "default": "{bg.switchOff}",
          "disabled": "{bg.muted}"
        }
      },
      "knob": {
        "bg": {
          "default": "{bg.surface}",
          "disabled": "{bg.switchKnobDisabled}"
        },
        "shadow": "0px 1px 3px 0px rgba(0,0,0,0.1)"
      },
      "icon": {
        "on": "{text.inverse}",
        "off": "{text.inverse}"
      },
      "size": {
        "lg": {
          "height": 24,
          "width": 40,
          "knob": 16
        },
        "md": {
          "height": 16,
          "width": 28,
          "knob": 12
        }
      }
    },
    "tag": {
      "status": {
        "tone": {
          "offline": {
            "bg": "{bg.statusOffline}",
            "text": "{text.secondary}",
            "border": "{text.secondary}"
          },
          "danger": {
            "bg": "{bg.statusDanger}",
            "text": "{status.danger}",
            "border": "{status.danger}"
          },
          "success": {
            "bg": "{bg.statusSuccess}",
            "text": "{status.success}",
            "border": "{status.success}"
          },
          "warning": {
            "bg": "{bg.statusWarning}",
            "text": "{status.warning}",
            "border": "{status.warning}"
          },
          "info": {
            "bg": "{bg.statusInfo}",
            "text": "{status.info}",
            "border": "{status.info}"
          }
        },
        "radiusMd": "{radius.sm}",
        "radiusLg": "{radius.md}",
        "minWidth": 44,
        "pxSm": 6,
        "pxMd": 8,
        "pySm": 2,
        "pyMd": 4,
        "pyLg": 6,
        "hSm": 20,
        "hMd": 24,
        "hLg": 32,
        "textSizeSm": 12,
        "textSizeMd": 14
      },
      "selector": {
        "bgDefault": "{bg.surface}",
        "bgHover": "{bg.muted}",
        "bgSelected": "{bg.surface}",
        "bgDisabled": "{bg.surface}",
        "borderSelected": "{text.primary}",
        "textDefault": "{text.primary}",
        "textDisabled": "{text.muted}",
        "radius": "{radius.sm}",
        "px": 12,
        "py": 2
      },
      "group": {
        "bgDefault": "{bg.page}",
        "bgHover": "{bg.muted}",
        "bgDisabled": "{bg.page}",
        "textDefault": "{text.primary}",
        "textDisabled": "{text.muted}",
        "iconDefault": "{text.primary}",
        "iconDisabled": "{text.muted}",
        "closeBgHover": "{bg.switchOff}",
        "radius": "{radius.md}",
        "gap": 8,
        "px": 8,
        "py": 6,
        "h": 32
      },
      "addButton": {
        "bg": "{bg.page}",
        "text": "{text.primary}",
        "icon": "{text.primary}",
        "radiusLg": "{radius.md}",
        "radiusMd": "{radius.sm}",
        "radiusSm": "{radius.sm}",
        "radiusXs": 2,
        "gap": 4,
        "px": 8,
        "pyLg": 5,
        "pyMd": 4,
        "pySm": 2,
        "hLg": 32,
        "iconSizeLg": 16,
        "iconSizeSm": 12,
        "textSizeLg": 14,
        "textSizeSm": 12
      }
    }
  }
}
